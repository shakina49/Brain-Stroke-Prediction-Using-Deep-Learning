<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Brain Stroke Prediction</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

    <style>
        body {
            margin-top: 60px;
            background: linear-gradient(to right, #f8f9fa, #e9ecef);
        }

        .container {
            max-width: 700px;
        }

        .card {
            border-radius: 20px;
            box-shadow: 0 6px 18px rgba(0,0,0,0.1);
        }

        img {
            margin-top: 15px;
            max-width: 100%;
            border-radius: 15px;
        }

        #loading {
            display: none;
            margin-top: 15px;
        }
    </style>
</head>

<body>

<div class="container">
    <div class="card p-4 text-center">

        <h2 class="mb-3">🧠 Brain Stroke CT Scan Analysis</h2>
        <p class="text-muted">Upload a Brain CT scan image for prediction</p>

        <!-- Upload Form -->
        <form method="POST" enctype="multipart/form-data"
              class="mb-3" onsubmit="showLoading()">

            <input type="file"
                   name="file"
                   accept="image/*"
                   class="form-control mb-3"
                   required>

            <button id="predictBtn"
                    type="submit"
                    class="btn btn-primary w-100">
                Predict
            </button>

            <!-- Loading Spinner -->
            <div id="loading" class="text-center">
                <div class="spinner-border text-primary mt-3"
                     role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Analyzing CT scan...</p>
            </div>
        </form>

        <!-- Result Section -->
        {% if result %}

            {% if "please upload" in result.lower()
               or "not confident" in result.lower()
               or "error" in result.lower() %}

                <div class="alert alert-warning mt-3">
                    ⚠️ <strong>{{ result }}</strong>
                </div>

            {% elif "stroke" in result.lower() %}

                <div class="alert alert-danger mt-3">
                    🔴 <strong>Prediction:</strong> {{ result }}
                </div>

            {% elif "normal" in result.lower() %}

                <div class="alert alert-success mt-3">
                    🟢 <strong>Prediction:</strong> {{ result }}
                </div>

            {% else %}

                <div class="alert alert-info mt-3">
                    {{ result }}
                </div>

            {% endif %}

        {% endif %}

        <!-- Uploaded Image -->
        {% if img_path %}
            <div class="mt-4">
                <h5>Uploaded Scan:</h5>
                <img src="{{ img_path }}" alt="Uploaded CT Scan">
            </div>
        {% endif %}

    </div>
</div>

<script>
    function showLoading() {
        document.getElementById("predictBtn").disabled = true;
        document.getElementById("predictBtn").innerText = "Predicting...";
        document.getElementById("loading").style.display = "block";
    }
</script>

</body>
</html>
